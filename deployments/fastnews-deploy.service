[Unit]
Description=FastNews HTTPS release receiver
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fastnews-deploy --config-dir %h/.config/fastnews-deploy --fastdeploy-dir %h/.local/share/fastnews-deploy/FastDeploy
Restart=on-failure
RestartSec=3
TimeoutStopSec=20min
KillMode=mixed
UMask=0077

[Install]
WantedBy=default.target
