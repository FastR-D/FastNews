# Go API、离线数据任务与 React 工作台配置。
# LLM 服务配置（OpenAI 兼容接口）
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库。

OPENAI_API_KEY=

# 可选：接口地址，默认 https://api.openai.com/v1
# OPENAI_BASE_URL = https://api.openai.com/v1

# 可选：模型名，默认 gemini-3-flash-preview
# LLM_MODEL = gemini-3-flash-preview

# RAG embedding（本地检索统一使用向量召回）
# 默认使用离线哈希向量，部署时可指定 OpenAI 兼容 embedding 接口：
# RAG_EMBEDDING_URL = https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL = text-embedding-3-small
# RAG_EMBEDDING_PROVIDER = openai

# FastNews Go API。报告默认公开；个人内容需要登录。
FASTRESEARCH_API_URL=http://127.0.0.1:8787
FASTREAD_URL=http://127.0.0.1:3015
FASTNEWS_HOST=127.0.0.1
FASTNEWS_PORT=4173
FASTNEWS_FASTCAS_ISSUER=
FASTNEWS_FASTCAS_CLIENT_ID=
FASTNEWS_FASTCAS_CLIENT_SECRET=
FASTNEWS_FASTCAS_REDIRECT_URI=
FASTNEWS_FASTCAS_ALLOW_LOOPBACK_HTTP=false

# FastNews public subpath when reverse-proxied at /news/.
FASTNEWS_PUBLIC_PATH=
FASTNEWS_ROOT=

# Native Go API / React workspace
FASTNEWS_DATA_DIR=.fastnews-data
FASTNEWS_WEB_DIR=web/dist
FASTNEWS_PUBLIC_ORIGIN=
# Keep true in production; loopback HTTP development only:
FASTNEWS_COOKIE_SECURE=true
FASTNEWS_REQUIRE_LOGIN=false
FASTNEWS_FASTCAS_ENABLED=true
FASTNEWS_FASTCAS_LOGIN_ENABLED=true
FASTNEWS_FASTCAS_LINK_ENABLED=true
FASTNEWS_FASTCAS_RESEARCH_CONNECT=false
FASTNEWS_FASTCAS_VAULT_KEY=
RAG_EMBEDDING_PROVIDER=auto
RAG_EMBEDDING_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Optional Chromium executable for Go CLI PDF exports.
FASTNEWS_CHROME=
