# 本地 python serve.py 使用这些变量，供 /api/related-work、/api/field-briefing 与 /api/fastread 调用。
# LLM 服务配置（OpenAI 兼容接口）
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库。

OPENAI_API_KEY = your-api-key-here

# 可选：接口地址，默认 https://api.openai.com/v1
# OPENAI_BASE_URL = https://api.openai.com/v1

# 可选：模型名，默认 gemini-3-flash-preview
# LLM_MODEL = gemini-3-flash-preview

# RAG embedding（本地检索统一使用向量召回）
# 默认使用离线哈希向量，部署时可指定 OpenAI 兼容 embedding 接口：
# RAG_EMBEDDING_URL = https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL = text-embedding-3-small
# RAG_EMBEDDING_PROVIDER = openai
# RAG_EMBEDDING_BATCH_SIZE = 64

# FastNews local gate (python serve.py). Direct :4173 is not a product entry.
FASTRESEARCH_API_URL=http://127.0.0.1:8787
FASTRESEARCH_PANEL_URL=http://127.0.0.1:5173
FASTNEWS_HOST=127.0.0.1
FASTNEWS_PORT=4173
FASTNEWS_ACCOUNT_DB=
FASTNEWS_INVITE_CODE=
FASTNEWS_FASTCAS_ISSUER=
FASTNEWS_FASTCAS_CLIENT_ID=
FASTNEWS_FASTCAS_CLIENT_SECRET=
FASTNEWS_FASTCAS_REDIRECT_URI=
FASTNEWS_FASTCAS_ALLOW_LOOPBACK_HTTP=false
# Set FASTNEWS_FASTCAS_SDK_PATH only when FastCAS is installed elsewhere.

# FastRead jump URL for POST /api/fastread
# FASTREAD_URL=http://127.0.0.1:3015
