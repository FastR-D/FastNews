<script>
  const root = document.documentElement;
  const themeToggle = document.getElementById("themeToggle");
  const sunIcon = themeToggle.querySelector(".theme-sun");
  const moonIcon = themeToggle.querySelector(".theme-moon");
  function updateThemeButton() {
    const dark = root.classList.contains("dark");
    sunIcon.hidden = dark; moonIcon.hidden = !dark;
    themeToggle.title = dark ? "切换浅色模式" : "切换深色模式";
    themeToggle.setAttribute("aria-label", themeToggle.title);
  }
  themeToggle.addEventListener("click", () => {
    const dark = !root.classList.contains("dark");
    root.classList.toggle("dark", dark);
    window.localStorage.setItem("fastnews.theme", dark ? "dark" : "light");
    updateThemeButton();
  });
  updateThemeButton();
</script>

{% if page_mode == 'home' %}
<script>
  const STORAGE_KEY = "fastnews.favoriteAuthors";
  const modal = document.getElementById("authorModal");
  const form = document.getElementById("authorForm");
  const list = document.getElementById("authorList");
  const sectionCount = document.getElementById("authorSectionCount");
  const statCount = document.getElementById("authorStatCount");
  const navCount = document.getElementById("authorNavCount");
  const gatewayCount = document.getElementById("authorGatewayCount");
  const toggleForm = document.getElementById("toggleAuthorForm");
  const closeForm = document.getElementById("closeAuthorForm");
  const cancelForm = document.getElementById("cancelAuthor");
  const formTitle = document.getElementById("authorFormTitle");
  const submitLabel = document.getElementById("submitAuthorLabel");
  let editingIndex = -1;
  let modalTrigger = null;
  function loadAuthors() {
    try {
      const raw = window.localStorage.getItem(STORAGE_KEY);
      const authors = raw ? JSON.parse(raw) : [];
      return Array.isArray(authors) ? authors : [];
    } catch { return []; }
  }
  function saveAuthors(authors) { window.localStorage.setItem(STORAGE_KEY, JSON.stringify(authors)); }
  function normalizeHomepage(value) {
    try { const url = new URL(value); return ["http:", "https:"].includes(url.protocol) ? url.href : ""; }
    catch { return ""; }
  }
  function escapeHtml(value) {
    return String(value).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
  }
  function updateCounts(count) {
    sectionCount.textContent = count + " 位作者"; statCount.textContent = count; gatewayCount.textContent = count;
    if (navCount) navCount.textContent = count;
  }
  function openAuthorForm(index = -1, trigger = document.activeElement) {
    editingIndex = index;
    const author = loadAuthors()[index];
    modalTrigger = trigger instanceof HTMLElement ? trigger : toggleForm;
    modal.hidden = false;
    document.body.classList.add("modal-open");
    toggleForm.setAttribute("aria-expanded", "true");
    formTitle.textContent = author ? "编辑作者" : "新增作者";
    submitLabel.textContent = author ? "保存修改" : "保存作者";
    form.querySelector("[name=name]").value = author?.name || "";
    form.querySelector("[name=bio]").value = author?.bio || "";
    form.querySelector("[name=homepage]").value = author?.homepage || "";
    form.querySelector("[name=name]").focus();
  }
  function closeAuthorEditor(restoreFocus = true) {
    if (modal.hidden) return;
    editingIndex = -1;
    form.reset();
    modal.hidden = true;
    document.body.classList.remove("modal-open");
    toggleForm.setAttribute("aria-expanded", "false");
    const trigger = modalTrigger;
    modalTrigger = null;
    if (restoreFocus && trigger?.isConnected) trigger.focus();
  }
  function modalFocusableElements() {
    return Array.from(form.querySelectorAll('button:not([disabled]), input:not([disabled]), textarea:not([disabled]), a[href]'));
  }
  function renderAuthors() {
    const authors = loadAuthors(); updateCounts(authors.length);
    if (!authors.length) { list.innerHTML = '<div class="empty">还没有添加关注作者。</div>'; return; }
    list.innerHTML = authors.map((author, index) => `
      <article class="author-row">
        <button class="author-row-main" type="button" data-edit-index="${index}" title="编辑 ${escapeHtml(author.name)}"><span class="author-name">${escapeHtml(author.name)}</span><span class="author-bio">${escapeHtml(author.bio)}</span><span class="author-url">${escapeHtml(author.homepage)}</span></button>
        <div class="author-actions"><a class="icon-button" href="${escapeHtml(author.homepage)}" target="_blank" rel="noopener noreferrer" aria-label="访问 ${escapeHtml(author.name)} 的主页" title="访问主页"><svg class="icon"><use href="#icon-external"></use></svg></a><button class="icon-button button-danger" type="button" data-delete-index="${index}" aria-label="删除 ${escapeHtml(author.name)}" title="删除作者"><svg class="icon"><use href="#icon-trash"></use></svg></button></div>
      </article>
    `).join("");
  }
  toggleForm.addEventListener("click", (event) => openAuthorForm(-1, event.currentTarget));
  closeForm.addEventListener("click", closeAuthorEditor);
  cancelForm.addEventListener("click", closeAuthorEditor);
  modal.addEventListener("click", (event) => {
    if (event.target.closest("[data-close-author-modal]")) closeAuthorEditor();
  });
  modal.addEventListener("keydown", (event) => {
    if (event.key === "Escape") { event.preventDefault(); closeAuthorEditor(); return; }
    if (event.key !== "Tab") return;
    const focusable = modalFocusableElements();
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const author = { name: String(data.get("name") || "").trim(), bio: String(data.get("bio") || "").trim(), homepage: normalizeHomepage(String(data.get("homepage") || "").trim()) };
    if (!author.name || !author.bio || !author.homepage) return;
    const authors = loadAuthors();
    const wasEditing = editingIndex >= 0 && Boolean(authors[editingIndex]);
    const savedIndex = wasEditing ? editingIndex : 0;
    if (wasEditing) authors[editingIndex] = author; else authors.unshift(author);
    saveAuthors(authors); closeAuthorEditor(false); renderAuthors();
    const savedRow = list.querySelector(`[data-edit-index="${savedIndex}"]`);
    (wasEditing ? savedRow : toggleForm)?.focus();
  });
  list.addEventListener("click", (event) => {
    const edit = event.target.closest("[data-edit-index]");
    if (edit) { openAuthorForm(Number(edit.dataset.editIndex), edit); return; }
    const remove = event.target.closest("[data-delete-index]");
    if (!remove) return;
    const authors = loadAuthors(); authors.splice(Number(remove.dataset.deleteIndex), 1); saveAuthors(authors); renderAuthors();
  });
  renderAuthors();
</script>
{% elif page_mode == 'secnews' %}
<script>
  const newsDays = {{ news_days_json|safe }};
  const newsDayMap = new Map(newsDays.map((item) => [item.date, item]));
  const articleBase = "{{ news_article_base }}";
  const summaryBase = "{{ news_summary_base }}";
  const calendarMonth = document.getElementById("calendarMonth");
  const calendarGrid = document.getElementById("calendarGrid");
  const previousMonth = document.getElementById("previousMonth");
  const nextMonth = document.getElementById("nextMonth");
  const newsDateTitle = document.getElementById("newsDateTitle");
  const newsDateCount = document.getElementById("newsDateCount");
  const newsList = document.getElementById("newsList");
  const weekdays = ["一", "二", "三", "四", "五", "六", "日"];
  let selectedDate = newsDays.length ? newsDays[newsDays.length - 1].date : "";
  let visibleMonth = selectedDate ? new Date(selectedDate + "T00:00:00") : new Date();
  let requestToken = 0;

  function pad(value) { return String(value).padStart(2, "0"); }
  function dateKey(date) { return date.getFullYear() + "-" + pad(date.getMonth() + 1) + "-" + pad(date.getDate()); }
  function escapeHtml(value) {
    return String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
  }
  function formatPublishedDate(value) {
    if (!value) return "";
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return String(value);
    return new Intl.DateTimeFormat("zh-CN", {
      year: "numeric", month: "2-digit", day: "2-digit",
      hour: "2-digit", minute: "2-digit", hour12: false,
    }).format(parsed).replaceAll("/", "-");
  }
  function formatDate(date) {
    const parts = date.split("-");
    return parts[0] + "年" + Number(parts[1]) + "月" + Number(parts[2]) + "日";
  }
  function sourceLabel(source) {
    if (source.includes("bleepingcomputer")) return "BleepingComputer";
    if (source.includes("arxiv")) return "arXiv";
    return "其他来源";
  }
  function monthKey(date) { return date.getFullYear() * 12 + date.getMonth(); }
  const availableMonths = newsDays.map((item) => monthKey(new Date(item.date + "T00:00:00")));
  const firstMonth = availableMonths.length ? Math.min(...availableMonths) : monthKey(new Date());
  const lastMonth = availableMonths.length ? Math.max(...availableMonths) : firstMonth;
  function updateMonthControls() {
    const current = monthKey(visibleMonth);
    previousMonth.disabled = current <= firstMonth;
    nextMonth.disabled = current >= lastMonth;
  }
  function renderCalendar() {
    const year = visibleMonth.getFullYear();
    const month = visibleMonth.getMonth();
    calendarMonth.textContent = year + "年" + (month + 1) + "月";
    updateMonthControls();
    const firstDay = (new Date(year, month, 1).getDay() + 6) % 7;
    const dayCount = new Date(year, month + 1, 0).getDate();
    const cells = weekdays.map((day) => `<span class="calendar-weekday">${day}</span>`);
    for (let i = 0; i < firstDay; i += 1) cells.push('<span class="calendar-day"></span>');
    for (let day = 1; day <= dayCount; day += 1) {
      const key = year + "-" + pad(month + 1) + "-" + pad(day);
      const info = newsDayMap.get(key);
      const classes = ["calendar-day"];
      const buttonClasses = [];
      if (info) buttonClasses.push("has-news");
      if (key === selectedDate) buttonClasses.push("selected");
      const label = info ? `${key}，${info.count} 条新闻` : `${key}，无新闻`;
      cells.push(`<span class="${classes.join(" ")}"><button class="${buttonClasses.join(" ")}" type="button" data-news-date="${key}" aria-label="${label}" ${info ? "" : "disabled"}>${day}</button></span>`);
    }
    calendarGrid.innerHTML = cells.join("");
  }
  function renderNews(articles) {
    if (!articles.length) {
      newsList.innerHTML = '<div class="news-status">这一天没有可展示的新闻。</div>';
      return;
    }
    newsList.innerHTML = articles.map((article) => {
      const categories = Array.isArray(article.categories) ? article.categories.slice(0, 2) : [];
      const tags = categories.map((category) => `<span class="news-tag">${escapeHtml(category)}</span>`).join("");
      const published = formatPublishedDate(article.published);
      const meta = [sourceLabel(String(article.source || "")), article.author || "", published ? "发布于 " + published : ""].filter(Boolean).map(escapeHtml).join(" · ");
      const title = article.title_zh || article.title || "无标题";
      const description = article.summary_zh || article.intro || article.description || "暂无摘要";
      return `<article class="news-row"><h4 class="news-title"><a href="${escapeHtml(article.link)}" target="_blank" rel="noopener noreferrer">${escapeHtml(title)}</a></h4><p class="news-description">${escapeHtml(description)}</p><div class="news-meta"><span>${meta}</span>${tags}</div></article>`;
    }).join("");
  }
  async function selectDate(date) {
    const info = newsDayMap.get(date);
    if (!info) return;
    selectedDate = date;
    visibleMonth = new Date(date + "T00:00:00");
    const url = new URL(window.location.href);
    if (url.searchParams.get("date") !== date) {
      url.searchParams.set("date", date);
      window.history.replaceState(null, "", url);
    }
    renderCalendar();
    newsDateTitle.textContent = formatDate(date);
    newsDateCount.textContent = info.count + " 条新闻";
    newsList.innerHTML = '<div class="news-status">正在加载新闻…</div>';
    const token = ++requestToken;
    try {
      let articles;
      const summaryResponse = await fetch(summaryBase + date + ".json");
      if (summaryResponse.ok) {
        const summaryPayload = await summaryResponse.json();
        if (summaryPayload.complete && Array.isArray(summaryPayload.articles)) articles = summaryPayload.articles;
      }
      if (!articles) {
        const response = await fetch(articleBase + date + ".jsonl");
        if (!response.ok) throw new Error("request failed");
        articles = [];
        for (const line of (await response.text()).split(/\r?\n/)) {
          if (!line.trim()) continue;
          try {
            const article = JSON.parse(line);
            if (article && typeof article === "object") articles.push(article);
          } catch {
            // Keep displaying valid entries when a JSONL line is malformed.
          }
        }
      }
      if (token === requestToken) renderNews(articles);
    } catch {
      if (token === requestToken) newsList.innerHTML = '<div class="news-status">新闻加载失败，请稍后重试。</div>';
    }
  }
  calendarGrid.addEventListener("click", (event) => {
    const button = event.target.closest("[data-news-date]");
    if (button) selectDate(button.dataset.newsDate);
  });
  previousMonth.addEventListener("click", () => { if (previousMonth.disabled) return; visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() - 1, 1); renderCalendar(); });
  nextMonth.addEventListener("click", () => { if (nextMonth.disabled) return; visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1); renderCalendar(); });
  window.addEventListener("popstate", () => {
    const date = new URL(window.location.href).searchParams.get("date");
    if (newsDayMap.has(date)) selectDate(date);
  });
  renderCalendar();
  const requestedDate = new URL(window.location.href).searchParams.get("date");
  if (newsDayMap.has(requestedDate)) selectedDate = requestedDate;
  if (selectedDate) selectDate(selectedDate);
  else { newsDateTitle.textContent = "暂无新闻"; newsDateCount.textContent = "0 条新闻"; newsList.innerHTML = '<div class="news-status">还没有抓取到新闻。</div>'; }
</script>
{% elif page_mode == 'top-conf' %}
<script>
  const conferencePapers = {{ conference_papers_json|safe }};
  const conferenceYear = document.getElementById("conferenceYear");
  const conferenceName = document.getElementById("conferenceName");
  const conferenceCategory = document.getElementById("conferenceCategory");
  const conferenceList = document.getElementById("conferenceList");
  const conferenceEmpty = document.getElementById("conferenceEmpty");
  const visibleConferenceCount = document.getElementById("visibleConferenceCount");
  const reportSearch = document.getElementById("reportSearch");
  const reportRows = Array.from(document.querySelectorAll(".report-row"));
  const visibleReportCount = document.getElementById("visibleReportCount");
  const reportEmpty = document.getElementById("reportEmpty");

  function escapeHtml(value) {
    return String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
  }
  function safeHttpUrl(value) {
    try {
      const url = new URL(value);
      return ["http:", "https:"].includes(url.protocol) ? url.href : "";
    } catch { return ""; }
  }
  function replaceOptions(select, values, emptyLabel, selectedValue = select.value) {
    const options = [new Option(emptyLabel, "")];
    values.forEach((item) => options.push(new Option(item.label, item.value)));
    select.replaceChildren(...options);
    select.value = values.some((item) => item.value === selectedValue) ? selectedValue : "";
  }
  function availablePapers({ includeConference = true, includeCategory = true } = {}) {
    return conferencePapers.filter((paper) => {
      if (conferenceYear.value && String(paper.year) !== conferenceYear.value) return false;
      if (includeConference && conferenceName.value && paper.conference !== conferenceName.value) return false;
      if (includeCategory && conferenceCategory.value && paper.category !== conferenceCategory.value) return false;
      return true;
    });
  }
  function updateConferenceOptions() {
    const conferences = new Map();
    availablePapers({ includeConference: false, includeCategory: false }).forEach((paper) => conferences.set(paper.conference, paper.conference_label));
    replaceOptions(
      conferenceName,
      Array.from(conferences, ([value, label]) => ({ value, label })).sort((a, b) => a.label.localeCompare(b.label, "zh-CN")),
      "全部会议"
    );
  }
  function updateCategoryOptions() {
    const categories = new Set(availablePapers({ includeCategory: false }).map((paper) => paper.category));
    replaceOptions(
      conferenceCategory,
      Array.from(categories).sort((a, b) => a.localeCompare(b, "zh-CN")).map((value) => ({ value, label: value })),
      "全部类别"
    );
  }
  function renderConferencePapers() {
    const papers = availablePapers();
    visibleConferenceCount.textContent = papers.length + " 条结果";
    conferenceEmpty.hidden = papers.length !== 0;
    conferenceList.hidden = papers.length === 0;
    conferenceList.innerHTML = papers.map((paper) => {
      const url = safeHttpUrl(paper.link);
      const title = escapeHtml(paper.title);
      const titleMarkup = url ? `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">${title}</a>` : title;
      const author = paper.author ? `<span>${escapeHtml(paper.author)}</span>` : "";
      return `<article class="conference-row"><h3 class="conference-title">${titleMarkup}</h3><p class="conference-summary">${escapeHtml(paper.summary || "暂无中文总结")}</p><div class="conference-meta"><span>${escapeHtml(paper.year + " · " + paper.conference_label)}</span><span class="conference-tag">${escapeHtml(paper.category)}</span>${author}</div></article>`;
    }).join("");
  }
  conferenceYear.addEventListener("change", () => { updateConferenceOptions(); updateCategoryOptions(); renderConferencePapers(); });
  conferenceName.addEventListener("change", () => { updateCategoryOptions(); renderConferencePapers(); });
  conferenceCategory.addEventListener("change", renderConferencePapers);

  reportSearch.addEventListener("input", () => {
    const query = reportSearch.value.trim().toLowerCase();
    let visible = 0;
    reportRows.forEach((row) => { const match = !query || row.dataset.search.includes(query); row.classList.toggle("is-hidden", !match); if (match) visible += 1; });
    visibleReportCount.textContent = visible + " 条结果"; reportEmpty.hidden = visible !== 0;
  });
  updateConferenceOptions();
  updateCategoryOptions();
  renderConferencePapers();
</script>
{% else %}
<script>
  const reportSearch = document.getElementById("reportSearch");
  const reportRows = Array.from(document.querySelectorAll(".report-row"));
  const visibleReportCount = document.getElementById("visibleReportCount");
  const reportEmpty = document.getElementById("reportEmpty");
  reportSearch.addEventListener("input", () => {
    const query = reportSearch.value.trim().toLowerCase();
    let visible = 0;
    reportRows.forEach((row) => { const match = !query || row.dataset.search.includes(query); row.classList.toggle("is-hidden", !match); if (match) visible += 1; });
    visibleReportCount.textContent = visible + " 条结果"; reportEmpty.hidden = visible !== 0;
  });
</script>
{% endif %}
</body>
</html>
