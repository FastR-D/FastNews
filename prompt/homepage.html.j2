<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page_title }} - FastNews</title>
<link rel="icon" type="image/svg+xml" href="{{ asset_prefix }}favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="{{ asset_prefix }}favicon-32.png">
<link rel="icon" href="{{ root_prefix }}favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="{{ asset_prefix }}apple-touch-icon.png">
<script>
  (() => {
    const applyTheme = () => {
      const saved = window.localStorage.getItem("fastresearch-theme") ?? window.localStorage.getItem("fastnews.theme");
      document.documentElement.classList.toggle("dark", saved === "dark");
    };
    const applySidebar = () => {
      const collapsed = window.localStorage.getItem("fastnews.sidebarCollapsed") === "1";
      document.documentElement.classList.toggle("sidebar-collapsed", collapsed);
    };
    applyTheme();
    applySidebar();
    window.addEventListener("pageshow", () => { applyTheme(); applySidebar(); });
  })();
</script>
<style>html:not(.fastnews-ready) .app-shell{visibility:hidden!important}</style>
<script src="{{ asset_prefix }}gate.js"></script>
<style>
  :root {
    --app-bg: #f0f5f2; --muted-bg: #eaf1ec; --surface: #ffffff; --soft: #f8faf8;
    --border: #d6e3db; --input-border: #cbd7d0; --primary: #155e45; --primary-deep: #104936;
    --primary-soft: #e8f3ed; --primary-border: #8fb9a0; --accent: #b45309; --accent-soft: #fffbeb;
    --accent-border: #fde68a; --accent-text: #92400e; --text: #172720; --muted: #567265;
    --subtle: #7f998d; --danger: #dc2626; --danger-soft: #fef2f2; --focus: rgba(21, 94, 69, 0.16);
  }
  html.dark {
    --app-bg: #151a19; --muted-bg: #18201d; --surface: #1b2220; --soft: #202925;
    --border: #2d3934; --input-border: #3c4b45; --primary: #2dd4bf; --primary-deep: #5eead4;
    --primary-soft: #042f2e; --primary-border: #315147; --accent: #fb923c; --accent-soft: #431407;
    --accent-border: #7c2d12; --accent-text: #fed7aa; --text: #f3f4f6; --muted: #a5b1ab;
    --subtle: #7f8c86; --danger: #f87171; --danger-soft: #431407; --focus: rgb(45 212 191 / .18);
  }
  * { box-sizing: border-box; }
  html { color-scheme: light; }
  html.dark { color-scheme: dark; }
  body {
    min-height: 100vh; margin: 0; background: var(--app-bg); color: var(--text);
    font: 14px/1.6 Inter, "Noto Sans SC", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  a { color: inherit; text-decoration: none; }
  button, input, textarea { font: inherit; }
  button { border: 0; }
  button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible { outline: 0; box-shadow: 0 0 0 3px var(--focus); }
  .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .icon { width: 16px; height: 16px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .icon-lg { width: 20px; height: 20px; }
  .icon-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  .app-shell { display: grid; grid-template-columns: 224px minmax(0, 1fr); min-height: 100vh; }
  html.sidebar-collapsed .app-shell { grid-template-columns: minmax(0, 1fr); }
  html.sidebar-collapsed .sidebar { display: none; }
  .topbar-start { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .sidebar-show { display: none; }
  html.sidebar-collapsed .sidebar-hide { display: none; }
  html.sidebar-collapsed .sidebar-show { display: block; }
  .nav-count.is-unread { color: #fff; background: var(--primary); border-radius: 999px; padding: 0 6px; min-width: 18px; text-align: center; }
  .sidebar {
    display: flex; position: sticky; top: 0; flex-direction: column; height: 100vh;
    padding: 16px 14px; background: var(--muted-bg); border-right: 1px solid var(--border);
  }
  .brand { display: flex; align-items: center; gap: 10px; padding: 8px; margin-bottom: 24px; }
  .brand-mark, .header-icon, .stat-icon, .gateway-icon {
    display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto;
    color: var(--primary); background: var(--primary-soft); border: 1px solid var(--primary-border); border-radius: 8px;
  }
  .brand-mark { width: 32px; height: 32px; color: #fff; background: var(--primary); }
  .brand-mark .icon { width: 18px; height: 18px; stroke-width: 2; }
  .brand-name { display: block; font-size: 15px; line-height: 1.25; font-weight: 700; }
  .brand-caption { display: block; margin-top: 2px; color: var(--subtle); font-size: 11px; }
  .nav-title { padding: 0 8px 8px; color: var(--subtle); font-size: 11px; font-weight: 650; text-transform: uppercase; }
  .nav-list { display: grid; gap: 3px; padding: 0; margin: 0; list-style: none; }
  .nav-list a, .mobile-nav a { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 13px; font-weight: 500; transition: background .2s, color .2s; }
  .nav-list a { justify-content: space-between; padding: 9px 10px; border-radius: 8px; }
  .nav-list a > span:first-child, .mobile-nav a > span:first-child { display: inline-flex; align-items: center; gap: 10px; }
  .nav-list a:hover, .mobile-nav a:hover { color: var(--text); background: var(--surface); }
  .nav-list a.active, .mobile-nav a.active { color: var(--primary-deep); font-weight: 650; background: var(--primary-soft); border: 1px solid var(--primary-border); }
  .nav-list .icon, .mobile-nav .icon { color: var(--subtle); }
  .nav-list a.active .icon, .mobile-nav a.active .icon { color: var(--primary); }
  .nav-count { color: var(--primary); font-size: 12px; font-variant-numeric: tabular-nums; }
  .sidebar-footer { padding: 12px 10px 2px; margin-top: auto; color: var(--subtle); font-size: 11px; }
  .main { min-width: 0; }
  .topbar {
    position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between;
    gap: 16px; height: 56px; padding: 0 24px; background: color-mix(in srgb, var(--surface) 92%, transparent);
    border-bottom: 1px solid var(--border); backdrop-filter: blur(8px);
  }
  .breadcrumb, .generated { color: var(--muted); font-size: 13px; }
  .breadcrumb strong { color: var(--text); font-weight: 600; }
  .topbar-actions { display: flex; align-items: center; gap: 8px; }
  .generated { white-space: nowrap; }
  .page { width: 100%; max-width: 1180px; padding: 24px; margin: 0 auto; }
  .mobile-nav { display: none; }
  .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 22px; }
  .header-copy { display: flex; align-items: flex-start; gap: 12px; min-width: 0; }
  .header-icon { width: 36px; height: 36px; }
  .header-icon .icon { width: 19px; height: 19px; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 0; font-size: 20px; line-height: 1.35; font-weight: 650; }
  .description { margin: 5px 0 0; color: var(--muted); font-size: 14px; }
  .badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 8px; color: var(--accent-text); font-size: 12px; font-weight: 600; white-space: nowrap; background: var(--accent-soft); border: 1px solid var(--accent-border); border-radius: 4px; }
  .badge::before { width: 6px; height: 6px; content: ""; background: var(--accent); border-radius: 50%; }
  .surface { overflow: hidden; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 18px; }
  .stat { display: flex; align-items: center; gap: 11px; min-width: 0; padding: 15px 18px; border-right: 1px solid var(--border); }
  .stat:last-child { border-right: 0; }
  .stat-icon { width: 30px; height: 30px; }
  .stat-copy { min-width: 0; }
  .stat-value { display: block; overflow: hidden; color: var(--text); font-size: 19px; line-height: 1.2; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
  .stat-value.type-value { font-size: 14px; }
  .stat-label { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; }
  .workspace { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr); gap: 18px; align-items: start; }
  .workspace.single-column { grid-template-columns: minmax(0, 1fr); }
  .section-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 58px; padding: 12px 16px; background: var(--soft); border-bottom: 1px solid var(--border); }
  h2 { margin-bottom: 0; font-size: 15px; line-height: 1.4; font-weight: 650; }
  .section-description { margin: 3px 0 0; color: var(--muted); font-size: 12px; }
  .section-count { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .gateway-list { display: grid; }
  .gateway-row { display: grid; grid-template-columns: 38px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 17px 18px; border-bottom: 1px solid var(--border); transition: background .2s; }
  .gateway-row:last-child { border-bottom: 0; }
  .gateway-row:hover { background: color-mix(in srgb, var(--primary-soft) 58%, var(--surface)); }
  .gateway-icon { width: 38px; height: 38px; }
  .gateway-icon.orange { color: var(--accent-text); background: var(--accent-soft); border-color: var(--accent-border); }
  .gateway-icon.gray { color: var(--muted); background: var(--muted-bg); border-color: var(--border); }
  .gateway-title { margin: 0; color: var(--text); font-size: 14px; font-weight: 650; }
  .gateway-description { margin: 4px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .gateway-meta { display: block; margin-top: 5px; color: var(--primary); font-size: 11px; font-weight: 600; }
  .gateway-arrow { color: var(--subtle); }
  .gateway-row:hover .gateway-arrow { color: var(--primary); }
  .button, .icon-button { display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .button { min-height: 34px; gap: 7px; padding: 7px 12px; color: var(--text); font-size: 13px; font-weight: 600; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
  .button:hover { background: var(--muted-bg); border-color: var(--input-border); }
  .button-primary { color: #fff; background: var(--primary); border-color: var(--primary); }
  .button-primary:hover { color: #fff; background: var(--primary-deep); border-color: var(--primary-deep); }
  .button-secondary { color: var(--primary-deep); background: var(--surface); border-color: var(--primary-border); }
  .button-danger { color: var(--danger); }
  .button-danger:hover { color: var(--danger); background: var(--danger-soft); border-color: var(--danger); }
  .button-sm { min-height: 32px; padding: 6px 10px; font-size: 12px; }
  .icon-button { width: 32px; height: 32px; padding: 0; color: var(--muted); background: transparent; border: 1px solid transparent; border-radius: 8px; }
  .icon-button:hover { color: var(--text); background: var(--muted-bg); border-color: var(--border); }
  .icon-button.button-danger:hover { color: var(--danger); background: var(--danger-soft); border-color: transparent; }
  body.modal-open { overflow: hidden; }
  .author-modal { position: fixed; inset: 0; z-index: 40; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .author-modal[hidden] { display: none; }
  .author-modal-backdrop { position: absolute; inset: 0; background: rgb(15 23 42 / .48); }
  .author-form { position: relative; width: min(100%, 560px); max-height: min(680px, calc(100vh - 48px)); overflow-y: auto; padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 18px 50px rgb(15 23 42 / .2); }
  .editor-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .section-label { display: block; color: var(--primary-deep); font-size: 12px; font-weight: 700; }
  .editor-hint { margin: 3px 0 0; color: var(--muted); font-size: 12px; }
  .field-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 12px; }
  .field-group { display: grid; gap: 6px; }
  .field-group.full { grid-column: 1 / -1; }
  .label { color: var(--muted); font-size: 12px; font-weight: 600; }
  .field { width: 100%; padding: 9px 10px; color: var(--text); font-size: 13px; background: var(--surface); border: 1px solid var(--input-border); border-radius: 8px; outline: none; }
  .field::placeholder { color: var(--subtle); }
  .field:focus { border-color: var(--primary); box-shadow: 0 0 0 3px var(--focus); }
  textarea.field { min-height: 76px; resize: vertical; }
  .editor-actions, .row-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .editor-actions { margin-top: 14px; }
  .author-list-head, .author-row { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr) minmax(0, 1fr) 68px; gap: 14px; align-items: center; }
  .author-list-head { padding: 9px 16px; color: var(--subtle); font-size: 11px; font-weight: 650; background: var(--soft); border-bottom: 1px solid var(--border); }
  .author-row { padding: 12px 16px; border-bottom: 1px solid var(--border); transition: background .2s; }
  .author-row:last-child { border-bottom: 0; }
  .author-row:hover { background: color-mix(in srgb, var(--primary-soft) 46%, var(--surface)); }
  .author-row-main { display: grid; grid-column: 1 / 4; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr) minmax(0, 1fr); gap: 14px; align-items: center; min-width: 0; padding: 0; color: inherit; font: inherit; text-align: left; background: transparent; border: 0; cursor: pointer; }
  .author-name, .author-bio, .author-url { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .author-name { color: var(--primary-deep); font-size: 13px; font-weight: 650; }
  .author-bio, .author-url { color: var(--muted); font-size: 12px; }
  .author-url { color: var(--primary-deep); }
  .author-actions { display: flex; width: 68px; min-width: 68px; justify-content: flex-end; gap: 4px; }
  .author-actions .icon-button { flex: 0 0 32px; }
  .report-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .search-field { position: relative; width: min(100%, 340px); }
  .search-field .icon { position: absolute; top: 50%; left: 10px; color: var(--subtle); transform: translateY(-50%); pointer-events: none; }
  .search-field .field { padding-left: 34px; }
  .conference-explorer { margin-bottom: 18px; }
  .filter-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--border); }
  .filter-group { display: grid; gap: 5px; min-width: 0; }
  .filter-group .field { min-width: 0; }
  .conference-list { min-height: 96px; }
  .conference-row { position: relative; padding: 15px 18px 15px 22px; border-bottom: 1px solid var(--border); }
  .conference-row:last-child { border-bottom: 0; }
  .conference-row::before { position: absolute; top: 0; bottom: 0; left: 0; width: 4px; content: ""; background: var(--accent); }
  .conference-title { margin: 0; font-size: 14px; line-height: 1.45; font-weight: 650; }
  .conference-title a { color: var(--primary-deep); }
  .conference-title a:hover { text-decoration: underline; }
  .conference-summary { margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.65; }
  .conference-meta { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 7px; color: var(--subtle); font-size: 12px; }
  .conference-tag { padding: 1px 6px; color: var(--accent-text); background: var(--accent-soft); border: 1px solid var(--accent-border); border-radius: 4px; }
  .report-row { position: relative; padding: 15px 18px 15px 22px; border-bottom: 1px solid var(--border); }
  .report-row:last-child { border-bottom: 0; }
  .report-row::before { position: absolute; top: 0; bottom: 0; left: 0; width: 4px; content: ""; background: var(--primary); }
  .report-row.is-hidden { display: none; }
  .report-title { margin: 0; font-size: 14px; line-height: 1.45; font-weight: 650; }
  .report-title a { color: var(--primary-deep); }
  .report-title a:hover { text-decoration: underline; }
  .meta { margin: 5px 0 0; color: var(--muted); font-size: 12px; }
  .row-actions { margin-top: 10px; }
  .empty { padding: 42px 18px; color: var(--subtle); font-size: 13px; text-align: center; }
  .news-calendar { padding: 16px; border-bottom: 1px solid var(--border); }
  .calendar-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .calendar-month { margin: 0; font-size: 16px; font-weight: 650; }
  .calendar-controls { display: flex; align-items: center; gap: 4px; }
  .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
  .calendar-weekday { padding: 3px 0 5px; color: var(--subtle); font-size: 11px; font-weight: 650; text-align: center; }
  .calendar-day { position: relative; min-width: 0; }
  .calendar-day button { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; min-height: 38px; padding: 4px; color: var(--muted); font-size: 13px; background: transparent; border: 1px solid transparent; border-radius: 8px; cursor: pointer; }
  .calendar-day button:hover:not(:disabled) { color: var(--primary-deep); background: var(--primary-soft); border-color: var(--primary-border); }
  .calendar-day button:disabled { color: var(--border); cursor: default; }
  .calendar-controls .icon-button:disabled { color: var(--border); cursor: default; opacity: .65; }
  .calendar-controls .icon-button:disabled:hover { background: transparent; border-color: transparent; }
  .calendar-day button.has-news { color: var(--text); font-weight: 650; }
  .calendar-day button.has-news::after { position: absolute; bottom: 4px; width: 4px; height: 4px; content: ""; background: var(--accent); border-radius: 50%; }
  .calendar-day button.selected { color: #fff; background: var(--primary); border-color: var(--primary); }
  .calendar-day button.selected::after { background: #fff; }
  .news-list-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 16px; background: var(--soft); border-bottom: 1px solid var(--border); }
  .news-date-title { margin: 0; font-size: 15px; font-weight: 650; }
  .news-list { min-height: 96px; }
  .news-row { position: relative; padding: 15px 18px 15px 22px; border-bottom: 1px solid var(--border); }
  .news-row:last-child { border-bottom: 0; }
  .news-row::before { position: absolute; top: 0; bottom: 0; left: 0; width: 4px; content: ""; background: var(--accent); }
  .news-title { margin: 0; font-size: 14px; line-height: 1.45; font-weight: 650; }
  .news-title a { color: var(--primary-deep); }
  .news-title a:hover { text-decoration: underline; }
  .news-description { margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.65; }
  .news-meta { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 7px; color: var(--subtle); font-size: 12px; }
  .news-tag { padding: 1px 6px; color: var(--accent-text); background: var(--accent-soft); border: 1px solid var(--accent-border); border-radius: 4px; }
  .news-status { padding: 42px 18px; color: var(--subtle); font-size: 13px; text-align: center; }
  @media (max-width: 920px) {
    .app-shell { display: block; }
    .sidebar { display: none; }
    .topbar { padding: 0 16px; }
    .mobile-nav { display: flex; gap: 4px; overflow-x: auto; padding: 8px 12px; background: var(--muted-bg); border-bottom: 1px solid var(--border); scrollbar-width: none; }
    .mobile-nav::-webkit-scrollbar { display: none; }
    .mobile-nav a { flex: 0 0 auto; padding: 6px 10px; font-size: 12px; border-radius: 8px; }
    .page { padding: 18px 16px 28px; }
    .page-header { display: block; margin-bottom: 18px; }
    .badge { margin-top: 12px; }
    .workspace, .workspace.single-column { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .generated { display: none; }
    .topbar { height: 52px; }
    .stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .stat { display: block; padding: 12px 10px; }
    .stat-icon { width: 28px; height: 28px; margin-bottom: 8px; }
    .stat-value { font-size: 17px; }
    .stat-value.type-value { font-size: 12px; }
    .stat-label { font-size: 11px; line-height: 1.4; }
    .gateway-row { grid-template-columns: 34px minmax(0, 1fr) 16px; gap: 10px; padding: 15px 14px; }
    .gateway-icon { width: 34px; height: 34px; }
    .field-grid { grid-template-columns: 1fr; }
    .field-group.full { grid-column: auto; }
    .author-modal { align-items: flex-end; padding: 12px; }
    .author-form { max-height: calc(100vh - 24px); padding: 18px 16px; }
    .author-list-head { display: none; }
    .author-row { grid-template-columns: minmax(0, 1fr) auto; gap: 8px; padding: 13px 14px; }
    .author-row-main { grid-column: 1; grid-template-columns: 1fr; gap: 3px; min-width: 0; }
    .report-toolbar { align-items: stretch; flex-direction: column; gap: 8px; padding: 12px 14px; }
    .search-field { width: 100%; }
    .filter-grid { grid-template-columns: 1fr; padding: 12px 14px; }
    .news-calendar { padding: 12px; }
    .calendar-day button { min-height: 34px; }
    .news-list-head { align-items: flex-start; flex-direction: column; gap: 3px; padding: 12px 14px; }
    .news-row { padding: 14px 14px 14px 18px; }
  }
  /* FastResearch Scientific Console Styling (统一浅绿科研质感) */
  :root {
    --app-bg: #f0f5f2;
    --muted-bg: #eaf1ec;
    --surface: #ffffff;
    --soft: #f8faf8;
    --border: #d6e3db;
    --input-border: #cbd7d0;
    --primary: #155e45;
    --primary-deep: #104936;
    --primary-soft: #e8f3ed;
    --primary-border: #8fb9a0;
    --accent: #b45309;
    --accent-soft: #fffbeb;
    --accent-border: #fde68a;
    --accent-text: #92400e;
    --text: #172720;
    --muted: #567265;
    --subtle: #7f998d;
    --focus: rgba(21, 94, 69, 0.16);
  }
  html.dark {
    --app-bg: #0d1713;
    --muted-bg: #14221c;
    --surface: #192b23;
    --soft: #111d17;
    --border: #233b30;
    --input-border: #2d4b3e;
    --primary: #34d399;
    --primary-deep: #10b981;
    --primary-soft: rgba(52, 211, 153, 0.12);
    --primary-border: #3b6b55;
    --accent: #fbbf24;
    --accent-soft: #451a03;
    --accent-border: #78350f;
    --accent-text: #fde68a;
    --text: #e2ede7;
    --muted: #8faea0;
    --subtle: #648275;
    --focus: rgba(52, 211, 153, 0.18);
  }
  body {
    min-height: 100vh;
    margin: 0;
    background-color: var(--app-bg);
    background-image:
      linear-gradient(to right, rgba(21, 94, 69, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(21, 94, 69, 0.035) 1px, transparent 1px);
    background-size: 32px 32px;
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  }
  html.dark body {
    background-color: #0d1713;
    background-image:
      linear-gradient(to right, rgba(52, 211, 153, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(52, 211, 153, 0.06) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .app-shell { min-height: 100vh; }
  .sidebar {
    background: var(--muted-bg);
    border-right: 1px solid var(--border);
  }
  .topbar {
    height: 64px;
    padding: 0 28px;
    background: rgba(246, 250, 247, 0.88);
    backdrop-filter: blur(12px) saturate(150%);
    border-bottom: 1px solid var(--border);
  }
  html.dark .topbar {
    background: rgba(13, 23, 19, 0.88);
    border-bottom: 1px solid var(--border);
  }
  .brand-mark {
    background: var(--primary);
    color: #ffffff;
    border-radius: 7px;
    box-shadow: 0 2px 6px rgba(21, 94, 69, 0.2);
  }
  .brand-name {
    color: var(--text);
    font-weight: 700;
  }
  .brand-name b {
    color: var(--primary);
  }
  .page {
    max-width: 1240px;
    padding: 32px 28px 48px;
  }
  .page-header {
    margin-bottom: 26px;
  }
  h1 {
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .description {
    line-height: 1.7;
    color: var(--muted);
  }
  .surface {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(21, 94, 69, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02);
  }
  .section-head, .news-list-head {
    background: var(--soft);
    border-bottom: 1px solid var(--border);
  }
  .stat-value {
    color: var(--primary);
    font-family: 'JetBrains Mono', monospace;
  }
  .report-title a, .conference-title a, .article-title a, .news-title a {
    color: var(--text);
    transition: color 0.15s ease;
  }
  .report-title a:hover, .conference-title a:hover, .article-title a:hover, .news-title a:hover {
    color: var(--primary);
  }
  .report-row:hover, .conference-row:hover, .article:hover, .news-row:hover, .gateway-row:hover, .author-row:hover {
    background: var(--primary-soft);
  }
  .conference-row::before, .news-row::before {
    background: var(--accent);
  }
  .badge, .conference-tag, .news-tag {
    font-family: 'JetBrains Mono', monospace;
    border-radius: 4px;
  }
  .badge {
    background: var(--accent-soft);
    color: var(--accent-text);
    border: 1px solid var(--accent-border);
  }
  .button-primary {
    background: var(--primary);
    color: #ffffff;
    border: 1px solid var(--primary-deep);
    border-radius: 6px;
    font-weight: 600;
    box-shadow: 0 2px 4px rgba(21, 94, 69, 0.15);
  }
  .button-primary:hover {
    background: var(--primary-deep);
  }
  .button, .icon-button {
    background: var(--surface);
    color: var(--primary);
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .button:hover, .icon-button:hover {
    background: var(--primary-soft);
    border-color: var(--primary);
  }
  .field {
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }
  .field:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--focus);
  }
  .pagination {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding: 12px 18px;
    border-top: 1px solid var(--border);
    background: var(--soft);
  }
  .pagination button {
    min-width: 32px;
    height: 30px;
    padding: 0 9px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 5px;
    cursor: pointer;
    font: 11px 'JetBrains Mono', monospace;
  }
  .pagination button:hover:not(:disabled), .pagination button.is-current {
    color: var(--primary);
    border-color: var(--primary);
    background: var(--primary-soft);
  }
  .pagination button:disabled {
    cursor: default;
    opacity: 0.45;
  }
  .pagination .pagination-info {
    margin-right: auto;
    color: var(--subtle);
    font: 11px 'JetBrains Mono', monospace;
  }
  @media (max-width: 920px) {
    .page { padding: 22px 16px 32px; }
    h1 { font-size: 28px; }
  }
  @media (max-width: 620px) {
    .topbar { height: 56px; padding: 0 16px; }
    .pagination { justify-content: center; padding: 10px 12px; }
    .pagination .pagination-info { display: none; }
  }
</style>
{% if page_mode == 'home' %}<link rel="stylesheet" href="assets/authors.css"><link rel="stylesheet" href="assets/today-news.css">{% endif %}
{% if page_mode == 'top-conf' %}<link rel="stylesheet" href="../assets/related-work.css">{% endif %}
{% if page_mode == 'field-briefing' %}<link rel="stylesheet" href="../assets/field-briefing.css">{% endif %}
{% if page_mode == 'secnews' %}<link rel="stylesheet" href="../assets/secnews-news.css">{% endif %}
{% if page_mode in ['inbox', 'impression'] %}<link rel="stylesheet" href="../assets/profile.css">{% endif %}
{% if page_mode in ['top-conf', 'field-briefing', 'inbox'] %}<link rel="stylesheet" href="{{ asset_prefix }}fastread.css">{% endif %}
</head>
<body>
<svg class="icon-sprite" aria-hidden="true" focusable="false">
  <symbol id="icon-zap" viewBox="0 0 24 24"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></symbol>
  <symbol id="icon-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></symbol>
  <symbol id="icon-graduation" viewBox="0 0 24 24"><path d="m2 10 10-5 10 5-10 5-10-5Z"/><path d="M6 12.5V16c2 1.5 4 2.25 6 2.25S16 17.5 18 16v-3.5"/><path d="M22 10v6"/></symbol>
  <symbol id="icon-newspaper" viewBox="0 0 24 24"><path d="M4 4h15a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="M7 8h9M7 12h9M7 16h5"/></symbol>
  <symbol id="icon-book" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/><path d="M8 7h8M8 11h6"/></symbol>
  <symbol id="icon-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
  <symbol id="icon-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></symbol>
  <symbol id="icon-profile" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20a8 8 0 0 1 16 0"/></symbol>
  <symbol id="icon-panel-close" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M13 10l-2 2 2 2"/></symbol>
  <symbol id="icon-panel-open" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M13 14l2-2-2-2"/></symbol>
  <symbol id="icon-file" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></symbol>
  <symbol id="icon-tag" viewBox="0 0 24 24"><path d="M20 13 13 20a2 2 0 0 1-3 0l-6-6a2 2 0 0 1 0-3V4h7a2 2 0 0 1 1 1l8 8Z"/><circle cx="8.5" cy="8.5" r="1"/></symbol>
  <symbol id="icon-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></symbol>
  <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
  <symbol id="icon-chevron-left" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
  <symbol id="icon-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
  <symbol id="icon-external" viewBox="0 0 24 24"><path d="M14 3h7v7M10 14 21 3M19 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h6"/></symbol>
  <symbol id="icon-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="icon-x" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
  <symbol id="icon-pencil" viewBox="0 0 24 24"><path d="m4 20 4.5-1L19 8.5a2.12 2.12 0 0 0-3-3L5.5 16 4 20Z"/><path d="m14.5 7.5 2 2"/></symbol>
  <symbol id="icon-trash" viewBox="0 0 24 24"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 14h10l1-14M9 7V4h6v3"/></symbol>
  <symbol id="icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></symbol>
  <symbol id="icon-moon" viewBox="0 0 24 24"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8Z"/></symbol>
</svg>

<div class="app-shell">
  <aside class="sidebar">
    <a class="brand" href="{{ home_path }}"><span class="brand-mark"><svg class="icon"><use href="#icon-zap"></use></svg></span><span><span class="brand-name">FastNews</span><span class="brand-caption">Research briefings</span></span></a>
    <div class="nav-title">Workspace</div>
    <nav aria-label="主导航"><ul class="nav-list">
      <li><a class="{% if page_mode == 'home' %}active{% endif %}" href="{{ home_path }}"><span><svg class="icon"><use href="#icon-dashboard"></use></svg>总览</span></a></li>
      <li><a class="{% if page_mode == 'inbox' %}active{% endif %}" href="{{ inbox_path }}"><span><svg class="icon"><use href="#icon-mail"></use></svg>私信</span><span class="nav-count" id="inboxNavCount">0</span></a></li>
      <li><a class="{% if page_mode == 'impression' %}active{% endif %}" href="{{ impression_path }}"><span><svg class="icon"><use href="#icon-profile"></use></svg>研究印象</span></a></li>
      <li><a class="{% if page_mode == 'top-conf' %}active{% endif %}" href="{{ top_conf_path }}"><span><svg class="icon"><use href="#icon-graduation"></use></svg>顶会报告</span><span class="nav-count">{{ top_conf_count }}</span></a></li>
      <li><a class="{% if page_mode == 'field-briefing' %}active{% endif %}" href="{{ field_briefing_path }}"><span><svg class="icon"><use href="#icon-book"></use></svg>领域导读</span><span class="nav-count">{{ field_briefing_top_conf_count }}</span></a></li>
      <li><a class="{% if page_mode == 'secnews' %}active{% endif %}" href="{{ secnews_path }}"><span><svg class="icon"><use href="#icon-newspaper"></use></svg>安全资讯</span><span class="nav-count">{{ secnews_count }}</span></a></li>
      <li><a href="{% if page_mode == 'home' %}#authors{% else %}{{ home_path }}#authors{% endif %}"><span><svg class="icon"><use href="#icon-users"></use></svg>关注作者</span><span class="nav-count" id="authorNavCount">0</span></a></li>
    </ul></nav>
    <div class="sidebar-footer">本地报告索引 · FastRead</div>
  </aside>
  <main class="main">
    <header class="topbar">
      <div class="topbar-start">
        <button class="icon-button" id="sidebarToggle" type="button" aria-label="隐藏总览栏" title="隐藏总览栏" aria-pressed="false">
          <svg class="icon sidebar-hide"><use href="#icon-panel-close"></use></svg>
          <svg class="icon sidebar-show"><use href="#icon-panel-open"></use></svg>
        </button>
        <div class="breadcrumb"><strong>FastNews</strong><span> / {{ page_label }}</span></div>
      </div>
      <div class="topbar-actions"><span class="generated">更新于 {{ generated_at }}</span><button class="icon-button" id="themeToggle" type="button" aria-label="切换深色模式" title="切换深色模式"><svg class="icon theme-sun"><use href="#icon-sun"></use></svg><svg class="icon theme-moon"><use href="#icon-moon"></use></svg></button></div>
    </header>
    <nav class="mobile-nav" aria-label="移动端导航">
      <a class="{% if page_mode == 'home' %}active{% endif %}" href="{{ home_path }}"><span><svg class="icon"><use href="#icon-dashboard"></use></svg>总览</span></a>
      <a class="{% if page_mode == 'inbox' %}active{% endif %}" href="{{ inbox_path }}"><span><svg class="icon"><use href="#icon-mail"></use></svg>私信</span></a>
      <a class="{% if page_mode == 'impression' %}active{% endif %}" href="{{ impression_path }}"><span><svg class="icon"><use href="#icon-profile"></use></svg>研究印象</span></a>
      <a class="{% if page_mode == 'top-conf' %}active{% endif %}" href="{{ top_conf_path }}"><span><svg class="icon"><use href="#icon-graduation"></use></svg>顶会报告</span></a>
      <a class="{% if page_mode == 'field-briefing' %}active{% endif %}" href="{{ field_briefing_path }}"><span><svg class="icon"><use href="#icon-book"></use></svg>领域导读</span></a>
      <a class="{% if page_mode == 'secnews' %}active{% endif %}" href="{{ secnews_path }}"><span><svg class="icon"><use href="#icon-newspaper"></use></svg>安全资讯</span></a>
      <a href="{% if page_mode == 'home' %}#authors{% else %}{{ home_path }}#authors{% endif %}"><span><svg class="icon"><use href="#icon-users"></use></svg>关注作者</span></a>
    </nav>
    <div class="page">
      <section class="page-header{% if page_mode == 'home' %} has-today-card{% endif %}">
        <div class="header-copy"><span class="header-icon">{% if page_mode == 'home' %}<svg class="icon"><use href="#icon-dashboard"></use></svg>{% elif page_mode == 'top-conf' %}<svg class="icon"><use href="#icon-graduation"></use></svg>{% elif page_mode == 'field-briefing' %}<svg class="icon"><use href="#icon-book"></use></svg>{% elif page_mode == 'inbox' %}<svg class="icon"><use href="#icon-mail"></use></svg>{% elif page_mode == 'impression' %}<svg class="icon"><use href="#icon-profile"></use></svg>{% else %}<svg class="icon"><use href="#icon-newspaper"></use></svg>{% endif %}</span><div><h1>{{ page_title }}</h1><p class="description">{{ page_description }}</p></div></div>
        {%- if page_mode == 'home' %}
        <details class="today-news-card{% if not home_news_date %} is-empty{% endif %}" id="todayNewsCard">
          <summary class="today-news-face">
            <span class="today-news-tape" aria-hidden="true"></span>
            <span class="today-news-stamp">{% if home_news_is_today %}TODAY{% else %}NEW{% endif %}</span>
            <span class="today-news-kicker">{% if home_news_is_today %}今日快讯{% elif home_news_date %}最新快讯{% else %}安全资讯{% endif %}</span>
            <strong class="today-news-date">{% if home_news_date %}{{ home_news_date_label }}{% else %}暂无资讯{% endif %}</strong>
            <span class="today-news-count">{% if home_news_date %}{{ home_news_count }} 条新鲜出炉{% else %}还没有抓取到新闻{% endif %}</span>
            {% if home_news_date %}<span class="today-news-hint">点我展开看看</span>{% endif %}
          </summary>
          {% if home_news_date %}
          <div class="today-news-panel" id="todayNewsPanel">
            <p class="today-news-panel-title">当天头条</p>
            <ul class="today-news-list" id="todayNewsList">
              {% for item in home_news_preview %}
              <li>
                {% if item.link %}
                <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
                {% else %}
                <span>{{ item.title }}</span>
                {% endif %}
                <span class="today-news-item-meta">{{ item.source }}{% if item.tag %} · {{ item.tag }}{% endif %}</span>
              </li>
              {% else %}
              <li><span>暂无头条预览</span></li>
              {% endfor %}
            </ul>
            {% if home_news_count > home_news_preview|length %}
            <p class="today-news-more">还有 {{ home_news_count - (home_news_preview|length) }} 条</p>
            {% endif %}
            <a class="today-news-jump" href="{{ secnews_path }}?date={{ home_news_date }}">前往当天资讯界面</a>
          </div>
          {% endif %}
        </details>
        {%- else %}
        <span class="badge">Local Index</span>
        {%- endif %}
      </section>
      <section class="surface stats" aria-label="概览统计">
        {%- if page_mode == 'home' %}
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-file"></use></svg></span><span class="stat-copy"><span class="stat-value">{{ reports|length }}</span><span class="stat-label">已生成报告</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-graduation"></use></svg></span><span class="stat-copy"><span class="stat-value">{{ top_conf_count }}</span><span class="stat-label">顶会报告</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-users"></use></svg></span><span class="stat-copy"><span class="stat-value" id="authorStatCount">0</span><span class="stat-label">关注作者</span></span></div>
        {%- elif page_mode == 'secnews' %}
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-newspaper"></use></svg></span><span class="stat-copy"><span class="stat-value">{{ news_days|length }}</span><span class="stat-label">可选日期</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-file"></use></svg></span><span class="stat-copy"><span class="stat-value">{{ news_total }}</span><span class="stat-label">新闻条目</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-dashboard"></use></svg></span><span class="stat-copy"><span class="stat-value type-value">{{ news_latest }}</span><span class="stat-label">最新日期</span></span></div>
        {%- elif page_mode == 'top-conf' %}
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-file"></use></svg></span><span class="stat-copy"><span class="stat-value">{{ conference_papers|length }}</span><span class="stat-label">已总结论文</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-graduation"></use></svg></span><span class="stat-copy"><span class="stat-value">{{ conference_count }}</span><span class="stat-label">会议</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-tag"></use></svg></span><span class="stat-copy"><span class="stat-value">{{ conference_category_count }}</span><span class="stat-label">研究类别</span></span></div>
        {%- elif page_mode == 'field-briefing' %}
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-graduation"></use></svg></span><span class="stat-copy"><span class="stat-value">{{ field_briefing_top_conf_count }}</span><span class="stat-label">顶会摘要</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-newspaper"></use></svg></span><span class="stat-copy"><span class="stat-value">{{ field_briefing_arxiv_count }}</span><span class="stat-label">近期 arXiv</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-tag"></use></svg></span><span class="stat-copy"><span class="stat-value">{{ field_briefing_category_count }}</span><span class="stat-label">研究类别</span></span></div>
        {%- elif page_mode == 'inbox' %}
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-mail"></use></svg></span><span class="stat-copy"><span class="stat-value" id="inboxStatUnread">0</span><span class="stat-label">未读</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-file"></use></svg></span><span class="stat-copy"><span class="stat-value" id="inboxStatTotal">0</span><span class="stat-label">历史推送</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-profile"></use></svg></span><span class="stat-copy"><span class="stat-value type-value">每日一篇</span><span class="stat-label">按研究印象</span></span></div>
        {%- elif page_mode == 'impression' %}
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-profile"></use></svg></span><span class="stat-copy"><span class="stat-value">4000</span><span class="stat-label">字上限</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-book"></use></svg></span><span class="stat-copy"><span class="stat-value type-value">导读 / 找论文</span><span class="stat-label">会结合印象</span></span></div>
        <div class="stat"><span class="stat-icon"><svg class="icon"><use href="#icon-mail"></use></svg></span><span class="stat-copy"><span class="stat-value type-value">每日推送</span><span class="stat-label">按印象匹配</span></span></div>
        {%- else %}
