{% elif page_mode == 'top-conf' %}
<script>
  const conferencePapers = {{ conference_papers_json|safe }};
  const conferenceYear = document.getElementById("conferenceYear");
  const conferenceName = document.getElementById("conferenceName");
  const conferenceCategory = document.getElementById("conferenceCategory");
  const conferenceList = document.getElementById("conferenceList");
  const conferenceEmpty = document.getElementById("conferenceEmpty");
  const conferencePagination = document.getElementById("conferencePagination");
  const visibleConferenceCount = document.getElementById("visibleConferenceCount");
  const paperSearch = document.getElementById("paperSearch");
  const paperFuzzyPane = document.getElementById("paperFuzzyPane");
  const paperRelatedPane = document.getElementById("paperRelatedPane");
  const relatedTopic = document.getElementById("relatedTopic");
  const relatedKeywords = document.getElementById("relatedKeywords");
  const relatedWorkSubmit = document.getElementById("relatedWorkSubmit");
  const relatedWorkStatus = document.getElementById("relatedWorkStatus");
  const reportSearch = document.getElementById("reportSearch");
  const reportRows = Array.from(document.querySelectorAll(".report-row"));
  const visibleReportCount = document.getElementById("visibleReportCount");
  const reportEmpty = document.getElementById("reportEmpty");
  let conferencePage = 1;
  let searchMode = "fuzzy";
  let relatedResults = null;
  const PAGE_SIZE = 20;
  const RELATED_CANDIDATE_LIMIT = 40;
  const RELATED_RESULT_LIMIT = 12;

  function escapeHtml(value) {
    return String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
  }
  function safeHttpUrl(value) {
    try {
      const url = new URL(value);
      return ["http:", "https:"].includes(url.protocol) ? url.href : "";
    } catch { return ""; }
  }
  function replaceOptions(select, values, emptyLabel, selectedValue = select.value) {
    const options = [new Option(emptyLabel, "")];
    values.forEach((item) => options.push(new Option(item.label, item.value)));
    select.replaceChildren(...options);
    select.value = values.some((item) => item.value === selectedValue) ? selectedValue : "";
  }
  function tokenize(value) {
    return String(value || "").toLowerCase().split(/[^a-z0-9\u4e00-\u9fff]+/i).map((part) => part.trim()).filter((part) => part.length >= 2);
  }
  function paperBlob(paper) {
    return [paper.title, paper.summary, paper.author, paper.category, paper.conference_label, paper.year].join(" ").toLowerCase();
  }
  function matchesFuzzy(paper, query) {
    const terms = String(query || "").trim().toLowerCase().split(/\s+/).filter(Boolean);
    if (!terms.length) return true;
    const hay = paperBlob(paper);
    return terms.every((term) => hay.includes(term));
  }
  function lexicalScore(paper, terms) {
    if (!terms.length) return 0;
    const title = String(paper.title || "").toLowerCase();
    const summary = String(paper.summary || "").toLowerCase();
    const category = String(paper.category || "").toLowerCase();
    const author = String(paper.author || "").toLowerCase();
    let score = 0;
    terms.forEach((term) => {
      if (title.includes(term)) score += 4;
      if (category.includes(term)) score += 3;
      if (summary.includes(term)) score += 2;
      if (author.includes(term)) score += 1;
    });
    return score;
  }
  function availablePapers({ includeConference = true, includeCategory = true } = {}) {
    const includeSearch = includeConference && includeCategory && searchMode === "fuzzy";
    const query = includeSearch ? paperSearch.value : "";
    return conferencePapers.filter((paper) => {
      if (conferenceYear.value && String(paper.year) !== conferenceYear.value) return false;
      if (includeConference && conferenceName.value && paper.conference !== conferenceName.value) return false;
      if (includeCategory && conferenceCategory.value && paper.category !== conferenceCategory.value) return false;
      if (includeSearch && !matchesFuzzy(paper, query)) return false;
      return true;
    });
  }
  function updateConferenceOptions() {
    const conferences = new Map();
    availablePapers({ includeConference: false, includeCategory: false }).forEach((paper) => conferences.set(paper.conference, paper.conference_label));
    replaceOptions(
      conferenceName,
      Array.from(conferences, ([value, label]) => ({ value, label })).sort((a, b) => a.label.localeCompare(b.label, "zh-CN")),
      "\u5168\u90e8\u4f1a\u8bae"
    );
  }
  function updateCategoryOptions() {
    const categories = new Set(availablePapers({ includeCategory: false }).map((paper) => paper.category));
    replaceOptions(
      conferenceCategory,
      Array.from(categories).sort((a, b) => a.localeCompare(b, "zh-CN")).map((value) => ({ value, label: value })),
      "\u5168\u90e8\u7c7b\u522b"
    );
  }
  function localReason(paper, terms) {
    const title = String(paper.title || "").toLowerCase();
    const category = String(paper.category || "").toLowerCase();
    const summary = String(paper.summary || "").toLowerCase();
    const hits = terms.filter((term) => title.includes(term) || category.includes(term) || summary.includes(term));
    if (hits.length && paper.category) return `\u4e0e\u300c${paper.category}\u300d\u65b9\u5411\u91cd\u53e0\uff0c\u5e76\u547d\u4e2d ${hits.slice(0, 3).join("\u3001")}`;
    if (hits.length) return `\u6807\u9898\u6216\u6458\u8981\u547d\u4e2d ${hits.slice(0, 3).join("\u3001")}`;
    return `\u4e0e ${paper.year} ${paper.conference_label} \u7684 ${paper.category} \u7814\u7a76\u76f8\u8fd1`;
  }
  function pickCandidates(papers, topic, keywords) {
    const terms = tokenize(`${topic} ${keywords}`);
    const scored = papers.map((paper) => ({ paper, score: lexicalScore(paper, terms) }));
    scored.sort((a, b) => b.score - a.score || b.paper.year - a.paper.year);
    const picked = [];
    const used = new Set();
    scored.forEach((item) => {
      if (item.score > 0 && picked.length < RELATED_CANDIDATE_LIMIT) {
        picked.push(item.paper);
        used.add(item.paper.id);
      }
    });
    scored.forEach((item) => {
      if (picked.length >= RELATED_CANDIDATE_LIMIT || used.has(item.paper.id)) return;
      picked.push(item.paper);
      used.add(item.paper.id);
    });
    return picked;
  }
  function localRelated(papers, topic, keywords) {
    const terms = tokenize(`${topic} ${keywords}`);
    const ranked = papers
      .map((paper) => ({ paper, score: lexicalScore(paper, terms), reason: localReason(paper, terms) }))
      .filter((item) => item.score > 0)
      .sort((a, b) => b.score - a.score);
    const max = ranked[0] ? ranked[0].score : 1;
    return ranked.slice(0, RELATED_RESULT_LIMIT).map((item) => ({
      paper: item.paper,
      score: item.score / max,
      reason: item.reason,
    }));
  }
  function serializeCandidate(paper) {
    return {
      id: paper.id,
      title: paper.title,
      category: paper.category,
      conference: paper.conference_label,
      year: paper.year,
      summary: String(paper.summary || "").slice(0, 240),
    };
  }
  function setRelatedStatus(message, kind = "") {
    if (!relatedWorkStatus) return;
    relatedWorkStatus.hidden = !message;
    relatedWorkStatus.textContent = message;
    relatedWorkStatus.dataset.kind = kind;
  }
  function paperArticle(entry) {
    const paper = entry.paper || entry;
    const url = safeHttpUrl(paper.link);
    const title = escapeHtml(paper.title);
    const titleMarkup = url ? `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">${title}</a>` : title;
    const author = paper.author ? `<span>${escapeHtml(paper.author)}</span>` : "";
    const reason = entry.reason ? `<p class="conference-reason">${escapeHtml(entry.reason)}</p>` : "";
    const score = Number.isFinite(Number(entry.score)) ? `<span class="conference-score">${Math.round(Number(entry.score) * 100)}</span>` : "";
    const actions = window.fastNewsFastReadButton ? `<div class="paper-actions">${window.fastNewsFastReadButton(paper)}</div>` : "";
    return `<article class="conference-row${entry.reason ? " has-reason" : ""}"><h3 class="conference-title">${titleMarkup}</h3><p class="conference-summary">${escapeHtml(paper.summary || "\u6682\u65e0\u4e2d\u6587\u603b\u7ed3")}</p>${reason}<div class="conference-meta"><span>${escapeHtml(paper.year + " \u00b7 " + paper.conference_label)}</span><span class="conference-tag">${escapeHtml(paper.category)}</span>${author}${score}</div>${actions}</article>`;
  }
  function visibleEntries() {
    if (searchMode === "related" && relatedResults) return relatedResults;
    return availablePapers().map((paper) => ({ paper }));
  }
  function renderConferencePapers() {
    const entries = visibleEntries();
    visibleConferenceCount.textContent = entries.length + " \u6761\u7ed3\u679c";
    conferenceEmpty.textContent = searchMode === "related" && relatedResults ? "\u6ca1\u6709\u5339\u914d\u7684\u76f8\u5173\u5de5\u4f5c\u3002" : "\u6ca1\u6709\u7b26\u5408\u7b5b\u9009\u6761\u4ef6\u7684\u8bba\u6587\u3002";
    conferenceEmpty.hidden = entries.length !== 0;
    conferenceList.hidden = entries.length === 0;
    const totalPages = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));
    conferencePage = Math.min(Math.max(conferencePage, 1), totalPages);
    const start = (conferencePage - 1) * PAGE_SIZE;
    conferenceList.innerHTML = entries.slice(start, start + PAGE_SIZE).map(paperArticle).join("");
    renderPagination(conferencePagination, conferencePage, entries.length ? totalPages : 0, (page) => { conferencePage = page; renderConferencePapers(); conferenceList.scrollIntoView({ behavior: "smooth", block: "start" }); });
  }
  function setSearchMode(mode) {
    searchMode = mode;
    paperFuzzyPane.classList.toggle("is-hidden", mode !== "fuzzy");
    paperRelatedPane.classList.toggle("is-hidden", mode !== "related");
    document.querySelectorAll(".paper-search-mode").forEach((button) => {
      const active = button.dataset.mode === mode;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-selected", active ? "true" : "false");
    });
    if (mode === "fuzzy") {
      relatedResults = null;
      setRelatedStatus("");
    }
    conferencePage = 1;
    renderConferencePapers();
  }
  function onFilterChange(level) {
    relatedResults = null;
    if (searchMode === "related") setRelatedStatus("\u7b5b\u9009\u5df2\u66f4\u65b0\uff0c\u8bf7\u91cd\u65b0\u63a8\u8350\u76f8\u5173\u5de5\u4f5c\u3002");
    conferencePage = 1;
    if (level === "year") { updateConferenceOptions(); updateCategoryOptions(); }
    else if (level === "name") updateCategoryOptions();
    renderConferencePapers();
  }
  async function requestRelatedWork(topic, keywords, candidates, impression) {
    const response = await fetch("/api/related-work", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ topic, keywords, impression, candidates: candidates.map(serializeCandidate) }),
    });
    if (!response.ok) throw new Error("related-work http " + response.status);
    const payload = await response.json();
    const items = Array.isArray(payload.items) ? payload.items : [];
    const byId = new Map(candidates.map((paper) => [String(paper.id), paper]));
    const mapped = [];
    const used = new Set();
    items.forEach((item) => {
      const paper = byId.get(String(item.id));
      if (!paper || used.has(paper.id)) return;
      used.add(paper.id);
      mapped.push({ paper, score: Number(item.score), reason: String(item.reason || "").trim() });
    });
    if (!mapped.length) throw new Error("empty llm ranking");
    return mapped.slice(0, RELATED_RESULT_LIMIT);
  }
  async function runRelatedWork(event) {
    event.preventDefault();
    const impression = String(window.FASTNEWS_IMPRESSION || "").trim();
    const topic = relatedTopic.value.trim();
    const keywords = relatedKeywords.value.trim();
    if (!topic && !keywords && !impression) {
      setRelatedStatus("请填写研究方向或关键词，或先在研究印象中写下你的方向。", "error");
      relatedTopic.focus();
      return;
    }
    const pool = availablePapers();
    if (!pool.length) {
      relatedResults = [];
      setRelatedStatus("\u5f53\u524d\u7b5b\u9009\u8303\u56f4\u5185\u6ca1\u6709\u8bba\u6587\u3002", "error");
      renderConferencePapers();
      return;
    }
    const searchTopic = topic || impression.slice(0, 120);
    const candidates = pickCandidates(pool, searchTopic, keywords);
    relatedWorkSubmit.disabled = true;
    setRelatedStatus("\u6b63\u5728\u6839\u636e\u7814\u7a76\u65b9\u5411\u68c0\u7d22 related work\u2026", "pending");
    try {
      relatedResults = await requestRelatedWork(topic, keywords, candidates, impression);
      setRelatedStatus(`\u5df2\u6839\u636e\u300c${topic || keywords || "\u7814\u7a76\u5370\u8c61"}\u300d\u63a8\u8350 ${relatedResults.length} \u7bc7\u76f8\u5173\u5de5\u4f5c\u3002`, "ok");
    } catch {
      relatedResults = localRelated(candidates, searchTopic, keywords);
      if (!relatedResults.length) setRelatedStatus("\u6ca1\u6709\u627e\u5230\u8db3\u591f\u76f8\u5173\u7684\u8bba\u6587\uff0c\u8bd5\u8bd5\u653e\u5bbd\u7b5b\u9009\u6216\u66f4\u6362\u5173\u952e\u8bcd\u3002", "error");
      else setRelatedStatus(`\u63a8\u8350\u670d\u52a1\u6682\u4e0d\u53ef\u7528\uff0c\u5df2\u7528\u672c\u5730\u76f8\u5173\u5ea6\u6392\u5e8f ${relatedResults.length} \u7bc7\u3002`, "fallback");
    } finally {
      relatedWorkSubmit.disabled = false;
      conferencePage = 1;
      renderConferencePapers();
    }
  }

  document.querySelectorAll(".paper-search-mode").forEach((button) => {
    button.addEventListener("click", () => setSearchMode(button.dataset.mode));
  });
  paperSearch.addEventListener("input", () => { conferencePage = 1; renderConferencePapers(); });
  paperRelatedPane.addEventListener("submit", runRelatedWork);
  conferenceYear.addEventListener("change", () => onFilterChange("year"));
  conferenceName.addEventListener("change", () => onFilterChange("name"));
  conferenceCategory.addEventListener("change", () => onFilterChange("category"));

  reportSearch.addEventListener("input", () => {
    const query = reportSearch.value.trim().toLowerCase();
    let visible = 0;
    reportRows.forEach((row) => { const match = !query || row.dataset.search.includes(query); row.classList.toggle("is-hidden", !match); if (match) visible += 1; });
    visibleReportCount.textContent = visible + " \u6761\u7ed3\u679c"; reportEmpty.hidden = visible !== 0;
  });
  updateConferenceOptions();
  updateCategoryOptions();
  renderConferencePapers();
</script>
{% else %}
<script>
  const reportSearch = document.getElementById("reportSearch");
  const reportRows = Array.from(document.querySelectorAll(".report-row"));
  const visibleReportCount = document.getElementById("visibleReportCount");
  const reportEmpty = document.getElementById("reportEmpty");
  reportSearch.addEventListener("input", () => {
    const query = reportSearch.value.trim().toLowerCase();
    let visible = 0;
    reportRows.forEach((row) => { const match = !query || row.dataset.search.includes(query); row.classList.toggle("is-hidden", !match); if (match) visible += 1; });
    visibleReportCount.textContent = visible + " 条结果"; reportEmpty.hidden = visible !== 0;
  });
</script>
{% endif %}
<script>
  (() => {
    let frame = 0;
    document.addEventListener('pointermove', (event) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        document.documentElement.style.setProperty('--pointer-x', `${event.clientX}px`);
        document.documentElement.style.setProperty('--pointer-y', `${event.clientY}px`);
        frame = 0;
      });
    }, { passive: true });
    document.addEventListener('pointerdown', (event) => {
      const target = event.target.closest('button, a, .gateway-row, .report-row, .conference-row, .news-row, .author-row');
      if (!target) return;
      target.classList.add('is-pressed');
      window.setTimeout(() => target.classList.remove('is-pressed'), 180);
    });
  })();
</script>
</body>
</html>
